# bulksms-api base URL - the host Locust targets by default (override per-run with -H/--host).
API_BASE_URL=http://localhost:8000

# Shared secret for the X-Api-Key/X-Signature scheme (public ingestion API) -
# must match bulksms-api's AUTH_API_KEY (see its .env). "dev-secret" is that
# project's default.
AUTH_API_KEY=dev-secret

# Mirrors bulksms-api's own AUTH_TEST_MODE. true (its default) means the API
# bypasses signing entirely, so SingleSmsUser/BulkSmsUser send unsigned
# requests too. Set to false only once you've also set AUTH_TEST_MODE=false
# on the API side - then this load test computes and sends the real signed
# headers, exercising the actual MD5/SHA1 signing path under load instead of
# skipping it.
AUTH_TEST_MODE=true

# Bootstrap Super Administrator created by `python seed_admin.py` in
# bulksms-api - used by AdminConsoleUser when data/user_pool.json (see
# provision_pool.py) hasn't been generated yet.
ADMIN_SUPER_ADMIN_EMAIL=admin@bulksms-platform.com
ADMIN_SUPER_ADMIN_PASSWORD=ChangeMe123!

# Rows in the bulk-upload CSV BulkSmsUser sends - built once at startup and
# reused for every request (see common.py), not regenerated per request.
BULK_CSV_ROWS=500
